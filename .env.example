POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agora

# Used by the app and Alembic (SQLAlchemy URL with the psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://changeme:changeme@127.0.0.1:5432/agora

# Local LLM served by Ollama (these are the defaults).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
# How long Ollama keeps the model in GPU memory after a call (Ollama's own default is 5m).
OLLAMA_KEEP_ALIVE=30m
